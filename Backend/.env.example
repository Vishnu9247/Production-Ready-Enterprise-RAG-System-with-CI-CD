# Azure OpenAI resource endpoint and credentials
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=replace-me
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64

# Pinecone serverless index
PINECONE_API_KEY=replace-me
PINECONE_HOST=https://your-index-host.svc.pinecone.io
PINECONE_INDEX_NAME=enterprise-rag
PINECONE_NAMESPACE=default
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_METRIC=cosine

# Azure Database for PostgreSQL Flexible Server
POSTGRES_HOST=your-server.postgres.database.azure.com
POSTGRES_PORT=5432
POSTGRES_DATABASE=rag_db
POSTGRES_USER=rag_app
POSTGRES_PASSWORD=replace-me
POSTGRES_SSLMODE=require
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10

# Azure Blob Storage. Prefer managed identity in Azure; otherwise set one secret below.
OBJECT_STORAGE_PROVIDER=azure_blob
AZURE_STORAGE_ACCOUNT_URL=https://your-account.blob.core.windows.net
AZURE_STORAGE_CONTAINER=rag-documents
AZURE_STORAGE_PREFIX=documents
# AZURE_STORAGE_CONNECTION_STRING=replace-me
# AZURE_STORAGE_ACCOUNT_KEY=replace-me
# AZURE_STORAGE_SAS_TOKEN=replace-me

# Retrieval and local extraction
ENVIRONMENT=development
DATA_DIRECTORY=Backend/data
# The container workflow sets this to true after all secrets are configured.
AUTO_INIT_DB=false
CHUNK_SIZE=1800
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=5
# RETRIEVAL_SCORE_THRESHOLD=0.70
KEYWORD_SEARCH_TOP_K=20
SEMANTIC_SEARCH_TOP_K=20
HYBRID_RRF_K=60
